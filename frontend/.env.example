# Local same-origin prefix served by the Vite and Compose proxies.
# On Vercel, set VITE_API_BASE_URL to the Render API's public HTTPS origin in project settings.
# VITE_ settings are public. Keep service credentials on Render only.
VITE_API_BASE_URL=/gateway
# Used by Vite in development only. Use port 3000 when the API runs there.
API_PROXY_TARGET=http://127.0.0.1:13000
# Optional in hosted builds. Operators can use their authenticated Temporal Cloud console.
VITE_TEMPORAL_UI_URL=http://127.0.0.1:8080
# The mock API does not include a currency code. Delhi prices are presented in INR.
VITE_DISPLAY_CURRENCY=INR
