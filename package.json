{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "worker": "node --env-file-if-exists=.env dist/temporal/worker.js",
    "test": "vitest run",
    "test:integration": "npm run build && node --env-file-if-exists=.env --test integration/*.test.cjs"
  },
  "dependencies": {
    "@temporalio/activity": "1.26.0",
    "@temporalio/client": "1.26.0",
    "@temporalio/worker": "1.26.0",
    "@temporalio/workflow": "1.26.0",
    "express": "^5.1.0",
    "redis": "^5.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.0",
    "vitest": "5.1.1"
  }
}
