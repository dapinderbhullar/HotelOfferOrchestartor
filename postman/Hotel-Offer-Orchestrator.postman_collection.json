{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run against the API on port 3000. Refresh Delhi starts a new execution unless a city workflow is already active."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "All Delhi hotels",
      "request": {
        "method": "GET",
        "header": [],
        "description": "A cold cache starts aggregation. Sample shows two of ten offers.",
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hotels"
          ],
          "query": [
            {
              "key": "city",
              "value": "delhi"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
