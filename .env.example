PORT=3000
# Local Node processes bind to loopback by default. Compose sets its own bind address.
# HOST=127.0.0.1
# Render sets PORT for its web service. Set HOST=0.0.0.0 on hosted HTTP services.
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
# For Temporal Cloud, set TEMPORAL_ADDRESS and TEMPORAL_NAMESPACE from the console.
# Set the secret TEMPORAL_API_KEY in the service environment to enable TLS and API-key authentication.
# Use the private Render supplier host:port to disable mock supplier routes on the public API.
# SUPPLIER_PRIVATE_ADDRESS=hotel-offer-suppliers:10000
# Exact browser origins allowed to call the API. Keep this unset for local same-origin use.
# CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
# Local supplier URLs default to the API port.
# SUPPLIER_A_URL=http://127.0.0.1:3000
# SUPPLIER_B_URL=http://127.0.0.1:3000
CACHE_TTL_SECONDS=300
PARTIAL_CACHE_TTL_SECONDS=30
